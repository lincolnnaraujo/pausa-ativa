# Copie este arquivo para .env antes de subir a stack:
#   cp .env.example .env
# O .env fica fora do git. Troque a senha.

POSTGRES_DB=pausaativa
POSTGRES_USER=pausaativa
POSTGRES_PASSWORD=troque-esta-senha

# Porta do frontend no host (sempre em 127.0.0.1): a aplicação abre em http://127.0.0.1:38742
# Use uma porta abaixo de 49152: acima disso o Windows (Hyper-V/WSL) reserva faixas que mudam a cada boot.
FRONTEND_PORT=38742

# Porta do Grafana no host (sempre em 127.0.0.1): o painel de métricas abre em http://127.0.0.1:38744
GRAFANA_PORT=38744

# Pasta dos backups (docker compose run --rm backup). Pode ser outra, por exemplo uma pasta sincronizada
# com a nuvem: um backup no mesmo disco da aplicação não protege contra a perda do disco.
BACKUP_DIR=./backups
