  "components" : {
    "schemas" : {
      "Bloco" : {
        "type" : "object",
        "description" : "Bloco de exercício do marco, como foi proposto no disparo.",
        "properties" : {
          "compensaAdiamento" : {
            "type" : "boolean",
            "description" : "Se o bloco compensa o anterior, que foi adiado; nesse caso tem 10 min"
          },
          "duracaoMin" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Duração do bloco: 5 ou 10 min",
            "example" : 5
          },
          "itens" : {
            "type" : "array",
            "description" : "Exercícios na ordem em que devem ser feitos",
            "items" : {
              "$ref" : "#/components/schemas/ItemDoBloco"
            }
          },
          "segundosEstimados" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Soma das estimativas dos exercícios, com as trocas",
            "example" : 278
          }
        },
        "required" : [ "compensaAdiamento", "duracaoMin", "itens", "segundosEstimados" ]
      },
      "IniciarJornada" : {
        "type" : "object",
        "properties" : {
          "duracaoBlocoMin" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 5,
            "description" : "Duração dos blocos de exercício do dia, em minutos: 5 ou 10. Sem ela, 5 min.",
            "example" : 5
          },
          "metaAguaMl" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 3000,
            "description" : "Meta de água do dia, em ml. Sem ela, 3.000 ml.",
            "example" : 3000,
            "maximum" : 6000,
            "minimum" : 1
          }
        }
      },
      "ItemDoBloco" : {
        "type" : "object",
        "properties" : {
          "exercicio" : {
            "type" : "string",
            "example" : "Sentar e levantar da cadeira"
          },
          "grupo" : {
            "type" : "string",
            "example" : "Pernas"
          },
          "instrucao" : {
            "type" : "string",
            "example" : "Sente e levante da cadeira sem usar as mãos, com os pés na largura do quadril."
          },
          "quantidade" : {
            "type" : "string",
            "description" : "\"10 repetições\", \"6 por lado\" ou \"20 s\"",
            "example" : "10 repetições"
          }
        },
        "required" : [ "exercicio", "grupo", "instrucao", "quantidade" ]
      },
      "Jornada" : {
        "type" : "object",
        "description" : "Situação da jornada no instante calculadoEm. Horários no fuso America/Sao_Paulo.",
        "properties" : {
          "aguaIngeridaMl" : {
            "type" : "number",
            "description" : "Soma dos marcos de hidratação concluídos",
            "example" : 562.5
          },
          "calculadoEm" : {
            "type" : "string",
            "format" : "date-time"
          },
          "dataReferencia" : {
            "type" : "string",
            "format" : "date",
            "description" : "Dia em que a jornada começou"
          },
          "duracaoBlocoMin" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Duração dos blocos de exercício escolhida ao iniciar o dia. O bloco que compensa um adiamento tem 10 min.",
            "example" : 5
          },
          "finalizadaEm" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "iniciadaEm" : {
            "type" : "string",
            "format" : "date-time"
          },
          "marcos" : {
            "type" : "array",
            "description" : "Água e exercício em ordem de horário; na hora cheia, a água vem antes",
            "items" : {
              "$ref" : "#/components/schemas/Marco"
            }
          },
          "metaAguaMl" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 3000
          },
          "pausadaDesde" : {
            "type" : [ "string", "null" ],
            "format" : "date-time",
            "description" : "Início da pausa em curso; nulo fora da pausa"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "EM_ANDAMENTO", "PAUSADA", "FINALIZADA", "ENCERRADA_AUTOMATICAMENTE" ]
          },
          "tempoTrabalhadoSegundos" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Tempo trabalhado até calculadoEm, sem as pausas. Enquanto a jornada estiver em andamento, a tela soma o tempo decorrido desde então.",
            "example" : 5400
          }
        },
        "required" : [ "aguaIngeridaMl", "calculadoEm", "dataReferencia", "duracaoBlocoMin", "finalizadaEm", "id", "iniciadaEm", "marcos", "metaAguaMl", "pausadaDesde", "status", "tempoTrabalhadoSegundos" ]
      },
      "Marco" : {
        "type" : "object",
        "description" : "Lembrete da jornada. Horários no fuso America/Sao_Paulo.",
        "properties" : {
          "bloco" : {
            "description" : "Bloco de exercício. Nulo na água e no exercício que ainda não disparou.",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/Bloco"
            }, {
              "type" : "null"
            } ]
          },
          "categoria" : {
            "type" : "string",
            "enum" : [ "HIDRATACAO", "EXERCICIO" ]
          },
          "disparadoEm" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "mensagem" : {
            "type" : "string",
            "example" : "Beba ~190 ml. Levante-se para buscar a água."
          },
          "podeAdiar" : {
            "type" : "boolean",
            "description" : "Se o botão Adiar vale agora: só no exercício pendente que não compensa um adiamento e não é o último do dia"
          },
          "recebidoEm" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "respondidoEm" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "segundosTrabalhadosPrevistos" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Tempo trabalhado em que o marco dispara",
            "example" : 1800
          },
          "sequencia" : {
