{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Jornada de trabalho com marcos de hidratação e exercício.",
    "title" : "Pausa Ativa API",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Mesma origem do frontend"
  } ],
  "tags" : [ {
    "description" : "Informações sobre a própria aplicação",
    "name" : "Sistema"
  }, {
    "description" : "Respostas aos lembretes",
    "name" : "Marco"
  }, {
    "description" : "Notificações do servidor para a tela, em tempo real",
    "name" : "Eventos"
  }, {
    "description" : "Iniciar, pausar, retomar e finalizar o dia",
    "name" : "Jornada"
  } ],
  "paths" : {
    "/api/v1/eventos" : {
      "get" : {
        "description" : "Eventos: marco-disparado (dados no formato Marco) e jornada-atualizada (formato Jornada). Um comentário \"ping\" a cada 20 s mantém a conexão. Ao reconectar, busque GET /api/v1/jornadas/atual para recuperar os marcos pendentes.",
        "operationId" : "conectar",
        "responses" : {
          "200" : {
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "description" : "Conexão aberta"
          }
        },
        "summary" : "Stream de eventos (Server-Sent Events)",
        "tags" : [ "Eventos" ]
      }
    },
    "/api/v1/jornadas" : {
      "post" : {
        "operationId" : "iniciar",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/IniciarJornada"
              }
            }
          }
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Jornada"
                }
              }
            },
            "description" : "Created"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Bad Request"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Not Found"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Conflict"
          }
        },
        "summary" : "Inicia o dia. Encerra antes a jornada esquecida de um dia anterior, se houver.",
        "tags" : [ "Jornada" ]
      }
    },
    "/api/v1/jornadas/atual" : {
      "get" : {
        "operationId" : "atual",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Jornada"
                }
              }
            },
            "description" : "Há jornada aberta ou de hoje"
          },
          "204" : {
            "description" : "Nenhuma jornada hoje"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Bad Request"
