  "components" : {
    "schemas" : {
      "IniciarJornada" : {
        "type" : "object",
        "properties" : {
          "metaAguaMl" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 3000,
            "description" : "Meta de água do dia, em ml. Sem ela, 3.000 ml.",
            "example" : 3000,
            "maximum" : 6000,
            "minimum" : 1
          }
        }
      },
      "Jornada" : {
        "type" : "object",
        "description" : "Situação da jornada no instante calculadoEm. Horários no fuso America/Sao_Paulo.",
        "properties" : {
          "aguaIngeridaMl" : {
            "type" : "number",
            "description" : "Soma dos marcos de hidratação concluídos",
            "example" : 562.5
          },
          "calculadoEm" : {
            "type" : "string",
            "format" : "date-time"
          },
          "dataReferencia" : {
            "type" : "string",
            "format" : "date",
            "description" : "Dia em que a jornada começou"
          },
          "finalizadaEm" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "iniciadaEm" : {
            "type" : "string",
            "format" : "date-time"
          },
          "marcos" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Marco"
            }
          },
          "metaAguaMl" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 3000
          },
          "status" : {
            "type" : "string",
            "enum" : [ "EM_ANDAMENTO", "PAUSADA", "FINALIZADA", "ENCERRADA_AUTOMATICAMENTE" ]
          },
          "tempoTrabalhadoSegundos" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Tempo trabalhado até calculadoEm, sem as pausas. Enquanto a jornada estiver em andamento, a tela soma o tempo decorrido desde então.",
            "example" : 5400
          }
        },
        "required" : [ "aguaIngeridaMl", "calculadoEm", "dataReferencia", "finalizadaEm", "id", "iniciadaEm", "marcos", "metaAguaMl", "status", "tempoTrabalhadoSegundos" ]
      },
      "Marco" : {
        "type" : "object",
        "description" : "Lembrete da jornada. Horários no fuso America/Sao_Paulo.",
        "properties" : {
          "categoria" : {
            "type" : "string",
            "enum" : [ "HIDRATACAO" ]
          },
          "disparadoEm" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "mensagem" : {
            "type" : "string",
            "example" : "Beba ~190 ml. Levante-se para buscar a água."
          },
          "recebidoEm" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "respondidoEm" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "segundosTrabalhadosPrevistos" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Tempo trabalhado em que o marco dispara",
            "example" : 1800
          },
          "sequencia" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Ordem do marco na categoria, a partir de 1",
            "example" : 1
          },
          "status" : {
            "type" : "string",
            "enum" : [ "AGENDADO", "PENDENTE", "CONCLUIDO", "FALHA", "NAO_ENTREGUE", "NAO_CONCLUIDO" ]
          },
          "volumeAproximadoMl" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Volume para exibir, arredondado para a dezena",
            "example" : 190
          },
          "volumeMl" : {
            "type" : "number",
            "description" : "Volume exato: meta ÷ 16",
            "example" : 187.5
          }
        },
        "required" : [ "categoria", "disparadoEm", "id", "mensagem", "recebidoEm", "respondidoEm", "segundosTrabalhadosPrevistos", "sequencia", "status", "volumeAproximadoMl", "volumeMl" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        }
      },
      "StatusResposta" : {
        "type" : "object",
        "description" : "Situação do backend. Não consulta o banco; o estado do banco fica em /actuator/health.",
        "properties" : {
          "agora" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Horário do servidor no fuso de negócio",
            "example" : "2026-10-01T09:00:00-03:00"
          },
          "aplicacao" : {
            "type" : "string",
            "example" : "pausa-ativa"
          },
          "fuso" : {
            "type" : "string",
            "example" : "America/Sao_Paulo"
          },
          "versao" : {
            "type" : "string",
            "example" : "0.1.0"
          }
        },
        "required" : [ "agora", "aplicacao", "fuso", "versao" ]
      }
    }
  }
}
