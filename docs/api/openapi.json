              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Conflict"
          }
        },
        "summary" : "Jornada aberta ou, sem ela, a de hoje",
        "tags" : [ "Jornada" ]
      }
    },
